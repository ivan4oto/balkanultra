{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS"
    },
    "deploy": {
        "preDeployCommand": ["python manage.py migrate && python manage.py load_athletes"],
        "startCommand": "gunicorn balkanultra.wsgi:application",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    },
    "providers": ["python"]
}